---
 .../developer_guide/prefill_phase_metrics.md  | 40 +++++++++++++++++++
 vllm_ascend/core/dyntra_lb_scheduler.py       |  1 +
 vllm_ascend/core/recompute_scheduler.py       |  1 +
 vllm_ascend/core/scheduler_profiling_chunk.py |  1 +
 4 files changed, 43 insertions(+)
